{
  "name": "pidash-frontend",
  "private": true,
  "version": "0.5.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "n=0; for f in $(find src -name '*.test.js' | sort); do node $f || exit 1; n=$((n+1)); done; [ $n -ge 9 ] || { echo \"npm test: expected at least 9 test files, ran $n\"; exit 1; }",
    "prepare": "cd .. && husky frontend/.husky"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "lucide": "^1.48.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "vite": "^8.2.2"
  }
}
